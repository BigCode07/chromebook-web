---
import Seccion from '../ui/Seccion.astro';
import { site } from '../../data/site';
---

<Seccion id="donde" labelledby="donde-titulo">
  <h2 id="donde-titulo" class="text-3xl font-bold md:text-[2.5rem]">Próximas fechas</h2>
  <ul class="mt-8 grid gap-3">
    {
      site.eventos.map((e) => (
        <li class="grid gap-2 rounded-2xl bg-papel p-5 text-lg sm:grid-cols-[10rem_1fr_auto] sm:items-center">
          <span class="font-bold text-azul">{e.fecha}</span>
          <span>{e.lugar}</span>
          <span class="font-bold text-azul">{e.tipo}</span>
        </li>
      ))
    }
  </ul>
</Seccion>
