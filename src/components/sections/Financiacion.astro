---
import Seccion from '../ui/Seccion.astro';
import Boton from '../ui/Boton.astro';
import Dato from '../ui/Dato.astro';
import Icono from '../ui/Icono.astro';
import { site } from '../../data/site';

const incluye = ['Chromebook', 'Talleres de uso y seguridad digital', 'Soporte después de la compra'];
const fechas = [
  { nombre: 'Cyber Monday' },
  { nombre: 'Black Friday' },
  { nombre: 'Navidad', lema: '“El regalo que les da autonomía”' },
];
---

<Seccion id="financiacion" labelledby="financiacion-titulo">
  <div class="grid items-start gap-10 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
    <div>
      <h2 id="financiacion-titulo" class="text-3xl font-bold md:text-[2.5rem]">En cuotas, con tu tarjeta</h2>
      <p class="mt-5 text-xl leading-relaxed text-texto-suave">
        Pensamos el paquete para que lo puedas regalar sin desacomodarte: cuotas con tu tarjeta y promociones con
        bancos aliados.
      </p>
      <h3 class="mt-9 text-xl font-bold">Fechas destacadas</h3>
      <ul class="mt-4 grid gap-3">
        {
          fechas.map((f) => (
            <li class="rounded-2xl border border-borde bg-papel px-5 py-4 text-lg">
              <span class="font-bold text-azul">{f.nombre}</span>
              {f.lema && <span class="mt-1 block text-texto-suave">{f.lema}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-3xl border-2 border-azul bg-papel p-7 md:p-9">
      <h3 class="text-2xl font-bold">Paquete Chromebook + Capacitación</h3>
      <p class="mt-4 text-xl font-bold"><Dato valor={site.paquete.precio} /></p>
      <p class="mt-3 text-lg"><Dato valor={site.paquete.cuotas} /></p>
      <ul class="mt-6 grid gap-3">
        {
          incluye.map((i) => (
            <li class="flex items-center gap-3 text-lg font-bold">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white">
                <Icono nombre="check" class="h-5 w-5" />
              </span>
              {i}
            </li>
          ))
        }
      </ul>
      <Boton href="#contacto" class="mt-8 w-full">Ver planes de cuotas</Boton>
    </div>
  </div>
</Seccion>
