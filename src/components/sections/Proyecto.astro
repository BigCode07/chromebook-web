---
import Seccion from '../ui/Seccion.astro';
import Boton from '../ui/Boton.astro';
import { site } from '../../data/site';

const cifras = [
  { valor: '55.905', texto: 'personas: la meta del 1%' },
  { valor: '12 meses', texto: 'de plazo' },
  { valor: '~2.800', texto: 'talleres estimados en el año' },
];
---

<Seccion id="proyecto" fondo="azul" labelledby="proyecto-titulo">
  <p class="text-lg font-bold text-[#f3c969]">El proyecto · Para bancos, organismos e inversores</p>
  <h2 id="proyecto-titulo" class="mt-2 max-w-3xl text-3xl font-bold text-white md:text-[2.5rem]">
    Digitalizar con seguridad al 1% de los jubilados en un año
  </h2>
  <dl class="mt-10 grid gap-5 lg:grid-cols-3">
    {
      cifras.map((c) => (
        <div class="rounded-3xl bg-white/10 p-7 ring-1 ring-white/25">
          <dt class="font-display text-4xl font-bold text-white md:text-5xl">{c.valor}</dt>
          <dd class="mt-2 text-lg text-[#d3deea]">{c.texto}</dd>
        </div>
      ))
    }
  </dl>
  {
    site.flags.mostrarLinkProyecto && (
      <div class="mt-10">
        <Boton href="/proyecto" variante="claro">
          Conocer el proyecto
        </Boton>
      </div>
    )
  }
</Seccion>
