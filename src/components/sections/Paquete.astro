---
import { Image } from 'astro:assets';
import Seccion from '../ui/Seccion.astro';
import { site } from '../../data/site';
import chromebook from '../../assets/images/chromebook.jpg';

const { precio, cuotas } = site.paquete;
---

<Seccion id="paquete" fondo="papel" labelledby="paquete-titulo">
  <h2 id="paquete-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">Todo en un solo paquete</h2>

  <div class="mt-10 grid gap-5 lg:grid-cols-[1.3fr_1fr] lg:grid-rows-2">
    <article class="overflow-hidden rounded-2xl border border-borde bg-crema lg:row-span-2">
      <Image
        src={chromebook}
        alt="Una laptop abierta sobre una mesa de madera, junto a una taza blanca. Imagen ilustrativa."
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 660px, 100vw"
        class="aspect-[16/9] w-full object-cover"
      />
      <div class="p-7">
        <h3 class="text-2xl font-bold">Una Chromebook</h3>
        <p class="mt-3 text-lg">
          Se prende en segundos y se actualiza sola. Para leer el diario, ver series, hacer trámites y hablar con la
          familia.
        </p>
        {
          site.equipo.fichaTecnica.length > 0 && (
            <dl class="mt-5 grid gap-4 text-lg sm:grid-cols-2">
              {site.equipo.fichaTecnica.map((f) => (
                <div>
                  <dt class="font-bold text-azul">{f.caracteristica}</dt>
                  <dd>{f.detalle}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </article>

    <article class="flex flex-col justify-center rounded-2xl bg-azul p-7 text-white">
      <h3 class="text-2xl font-bold text-white">Talleres incluidos</h3>
      <p class="mt-3 text-lg">Presenciales y en grupos chicos. La capacitación no es un extra: es parte del producto.</p>
    </article>

    <article id="financiacion" class="ancla flex flex-col justify-center rounded-2xl bg-celeste p-7">
      <h3 class="text-2xl font-bold">Cuotas y soporte</h3>
      {precio && <p class="mt-3 text-3xl font-bold text-azul">{precio}</p>}
      <p class="mt-3 text-lg">{cuotas || 'Pagás en cuotas con tu tarjeta.'} Y tienen soporte después de la compra.</p>
    </article>
  </div>
</Seccion>
