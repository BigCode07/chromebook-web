---
import Seccion from '../ui/Seccion.astro';
import Dato from '../ui/Dato.astro';
import { site } from '../../data/site';

const preguntas: { q: string; a: string; dato?: typeof site.capacitacion.sedes }[] = [
  { q: '¿La capacitación se paga aparte?', a: 'No. Está incluida en el paquete.' },
  {
    q: 'Mi papá nunca usó una computadora, ¿va a poder?',
    a: 'Sí. Los talleres están pensados para empezar de cero, en grupos chicos y con un embajador de su edad.',
  },
  {
    q: '¿Dónde se dan los talleres?',
    a: 'En centros de jubilados, municipios, bancos aliados y espacios comunitarios.',
    dato: site.capacitacion.sedes,
  },
  {
    q: '¿Lo puedo pagar en cuotas?',
    a: 'Sí, con tu tarjeta.',
    dato: site.capacitacion.detalleCuotas,
  },
  {
    q: '¿Qué pasa si después del taller le surge una duda?',
    a: 'Tiene soporte posterior a la compra.',
    dato: site.capacitacion.soporte,
  },
  {
    q: '¿Esto garantiza que no lo van a estafar?',
    a: 'Nadie puede garantizar eso. Lo que sí hacemos es enseñarle a reconocer los engaños más comunes y a saber qué hacer si algo parece raro.',
  },
  {
    q: '¿Por qué una Chromebook y no una notebook común?',
    a: 'Porque es más simple, se prende rápido y se actualiza sola. Menos pasos, menos confusión.',
  },
];
---

<Seccion id="preguntas" labelledby="preguntas-titulo">
  <div class="mx-auto max-w-3xl">
    <h2 id="preguntas-titulo" class="text-3xl font-bold md:text-[2.5rem]">Preguntas frecuentes</h2>
    <div class="mt-10 grid gap-4">
      {
        preguntas.map((p, i) => (
          <details class="rounded-2xl border border-borde bg-papel" open={i === 0}>
            <summary class="flex min-h-16 items-center justify-between gap-4 px-6 py-4 text-xl font-bold leading-snug text-azul">
              {p.q}
              <span
                class="faq-mas flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-celeste text-2xl leading-none transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-6 pb-6 text-lg text-texto-suave">
              <p>{p.a}</p>
              {p.dato && (
                <p class="mt-3">
                  <Dato valor={p.dato} />
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Seccion>
