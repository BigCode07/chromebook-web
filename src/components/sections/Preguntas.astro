---
import Seccion from '../ui/Seccion.astro';
import { site } from '../../data/site';

const preguntas = [
  {
    q: 'Nunca usó una computadora, ¿va a poder?',
    a: 'Sí. Los talleres empiezan de cero, en grupos chicos y con un embajador de su edad.',
  },
  {
    q: '¿Dónde se dan los talleres?',
    a: site.capacitacion.sedes || 'En centros de jubilados, municipios y espacios comunitarios. Al contactarte te contamos cuál te queda cerca.',
  },
  {
    q: '¿Esto garantiza que no lo van a estafar?',
    a: 'Nadie puede garantizar eso. Le enseñamos a reconocer los engaños más comunes y qué hacer si algo parece raro.',
  },
  {
    q: '¿Por qué una Chromebook y no una notebook común?',
    a: 'Porque es más simple, se prende rápido y se actualiza sola. Menos pasos, menos confusión.',
  },
];
---

<Seccion id="preguntas" labelledby="preguntas-titulo">
  <div class="mx-auto max-w-3xl">
    <h2 id="preguntas-titulo" class="text-3xl font-bold md:text-[2.5rem]">Preguntas frecuentes</h2>
    <div class="mt-10 grid gap-4">
      {
        preguntas.map((p, i) => (
          <details class="rounded-2xl border border-borde bg-papel" open={i === 0}>
            <summary class="flex min-h-16 items-center justify-between gap-4 px-6 py-4 text-xl font-bold leading-snug text-azul [overflow-wrap:anywhere]">
              {p.q}
              <span
                class="faq-mas flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-celeste text-2xl leading-none transition-transform"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-6 pb-6 text-lg text-texto-suave">
              <p>{p.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Seccion>
