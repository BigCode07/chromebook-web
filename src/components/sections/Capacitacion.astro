---
import { Image } from 'astro:assets';
import Seccion from '../ui/Seccion.astro';
import Icono from '../ui/Icono.astro';
import { site } from '../../data/site';
import taller from '../../assets/images/taller.jpg';

const modulos = [
  { icono: 'compu', titulo: 'Usar el equipo', texto: 'Wifi, correo, videollamadas y series, desde cero.' },
  { icono: 'escudo', titulo: 'Cuidarse de las estafas', texto: 'Mensajes falsos, claves y páginas oficiales.' },
  { icono: 'chat', titulo: 'Entender la inteligencia artificial', texto: 'Para qué sirve y cómo distinguir lo real de lo falso.' },
] as const;
---

<Seccion id="capacitacion" fondo="papel" labelledby="capacitacion-titulo">
  <h2 id="capacitacion-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">
    Aprenden en grupos chicos, a su ritmo
  </h2>
  <Image
    src={taller}
    alt="Un taller grupal: personas mayores sentadas en fila frente a sus laptops, mientras un instructor se inclina a ayudar a una de ellas."
    widths={[480, 720, 960, 1200]}
    sizes="(min-width: 1216px) 1152px, 100vw"
    class="mt-8 aspect-[3/2] w-full rounded-2xl object-cover md:aspect-[5/2]"
  />
  <div class="mt-10 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-14">
    <figure class="m-0 rounded-2xl bg-celeste p-7">
      <div class="flex flex-wrap items-end gap-x-6 gap-y-4" aria-hidden="true">
        <Icono nombre="persona" class="h-16 w-16 text-terracota" />
        <div class="grid grid-cols-5 gap-2 text-azul sm:grid-cols-10 lg:grid-cols-5">
          {Array.from({ length: 20 }, () => <Icono nombre="persona" class="h-7 w-7" />)}
        </div>
      </div>
      <figcaption class="mt-5 text-xl font-bold text-azul">Un embajador cada unas 20 personas</figcaption>
    </figure>
    <dl class="grid gap-7">
      {
        modulos.map((m) => (
          <div class="grid grid-cols-[4rem_1fr] gap-x-5">
            <dt class="col-start-2 text-xl font-bold text-azul">{m.titulo}</dt>
            <dd class="col-start-2 text-lg text-texto-suave">
              {m.texto}
            </dd>
            <dd class="col-start-1 row-span-2 row-start-1 flex h-16 w-16 items-center justify-center rounded-2xl bg-azul text-white" aria-hidden="true">
              <Icono nombre={m.icono} class="h-9 w-9" />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
  {site.capacitacion.duracion && <p class="mt-4 text-lg">{site.capacitacion.duracion}</p>}
</Seccion>
