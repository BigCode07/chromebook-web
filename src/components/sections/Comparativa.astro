---
import Seccion from '../ui/Seccion.astro';
import Dato from '../ui/Dato.astro';
import Icono from '../ui/Icono.astro';
import { site } from '../../data/site';

type Valor = 'Sí' | 'No' | 'A veces' | 'Según vendedor';

const columnas = ['Solo celular', 'Notebook común'] as const;
const filas: { caracteristica: string; celular: Valor; notebook: Valor; paquete: Valor }[] = [
  { caracteristica: 'Pantalla grande', celular: 'No', notebook: 'Sí', paquete: 'Sí' },
  { caracteristica: 'Simple de usar', celular: 'Sí', notebook: 'No', paquete: 'Sí' },
  { caracteristica: 'Actualizaciones automáticas', celular: 'Sí', notebook: 'A veces', paquete: 'Sí' },
  { caracteristica: 'Capacitación en seguridad incluida', celular: 'No', notebook: 'No', paquete: 'Sí' },
  { caracteristica: 'Soporte posterior', celular: 'No', notebook: 'Según vendedor', paquete: 'Sí' },
];

const icono = (v: Valor) => (v === 'Sí' ? 'si' : v === 'No' ? 'no' : 'parcial');
const color = (v: Valor) =>
  v === 'Sí' ? 'text-whatsapp' : v === 'No' ? 'text-terracota' : 'text-aviso-texto';
---

<Seccion id="comparativa" fondo="papel" labelledby="comparativa-titulo">
  <h2 id="comparativa-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">
    El celular ya lo tienen. Esto es otra cosa.
  </h2>
  <p class="mt-5 max-w-3xl text-xl leading-relaxed text-texto-suave">
    Hoy casi todos se conectan desde el celular: en hogares urbanos, el 90,4% tenía acceso a internet, pero solo el
    42,3% usaba una computadora (INDEC, cuarto trimestre de 2021). La pantalla chica, las letras diminutas y los
    mensajes que llegan sin parar hacen que sea más fácil equivocarse. Una pantalla grande, un teclado y una
    capacitación pensada para ellos cambian la experiencia.
  </p>

  <!-- Tabla (desde 1024px) -->
  <div class="mt-10 hidden lg:block">
    <table class="w-full border-collapse overflow-hidden rounded-3xl border border-borde text-left text-lg">
      <caption class="sr-only">
        Comparación entre solo celular, notebook común y el paquete
        {typeof site.marca === 'string' ? site.marca : ''}
      </caption>
      <thead>
        <tr class="bg-celeste">
          <th scope="col" class="px-5 py-4 font-bold text-azul">Característica</th>
          {columnas.map((c) => <th scope="col" class="px-5 py-4 font-bold text-azul">{c}</th>)}
          <th scope="col" class="bg-azul px-5 py-4 font-bold text-white"><Dato valor={site.marca} /></th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => (
            <tr class="border-t border-borde">
              <th scope="row" class="px-5 py-4 font-bold text-texto">{f.caracteristica}</th>
              {[f.celular, f.notebook].map((v) => (
                <td class="px-5 py-4">
                  <span class={`inline-flex items-center gap-2 font-bold ${color(v)}`}>
                    <Icono nombre={icono(v)} class="h-6 w-6" />
                    {v}
                  </span>
                </td>
              ))}
              <td class="bg-celeste/60 px-5 py-4">
                <span class={`inline-flex items-center gap-2 font-bold ${color(f.paquete)}`}>
                  <Icono nombre={icono(f.paquete)} class="h-6 w-6" />
                  {f.paquete}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Tarjetas (menos de 1024px) -->
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:hidden">
    {
      filas.map((f) => (
        <li class="rounded-2xl border border-borde bg-crema p-5">
          <h3 class="text-xl font-bold">{f.caracteristica}</h3>
          <dl class="mt-3 grid gap-2 text-lg">
            {[
              ['Solo celular', f.celular],
              ['Notebook común', f.notebook],
            ].map(([nombre, v]) => (
              <div class="flex items-center justify-between gap-3">
                <dt class="text-texto-suave">{nombre}</dt>
                <dd class={`inline-flex items-center gap-2 font-bold ${color(v as Valor)}`}>
                  <Icono nombre={icono(v as Valor)} class="h-6 w-6" />
                  {v}
                </dd>
              </div>
            ))}
            <div class="flex items-center justify-between gap-3 rounded-xl bg-celeste px-3 py-2">
              <dt class="font-bold text-azul"><Dato valor={site.marca} /></dt>
              <dd class={`inline-flex items-center gap-2 font-bold ${color(f.paquete)}`}>
                <Icono nombre={icono(f.paquete)} class="h-6 w-6" />
                {f.paquete}
              </dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ul>
</Seccion>
