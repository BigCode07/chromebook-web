---
import Seccion from '../ui/Seccion.astro';
import Icono, { type NombreIcono } from '../ui/Icono.astro';

const usos: { icono: NombreIcono; texto: string }[] = [
  { icono: 'banco', texto: 'Revisar sus cuentas bancarias con tranquilidad, sabiendo detectar un mensaje falso.' },
  { icono: 'diario', texto: 'Leer el diario con letra grande y sin forzar la vista.' },
  { icono: 'tv', texto: 'Ver sus series y películas en una pantalla cómoda.' },
  { icono: 'video', texto: 'Hablar con la familia por videollamada.' },
  { icono: 'tramite', texto: 'Hacer trámites en las páginas oficiales, sabiendo cuáles son las verdaderas.' },
];
---

<Seccion id="usos" labelledby="usos-titulo">
  <h2 id="usos-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">
    Lo que hacen todos los días, en una pantalla más grande y más segura
  </h2>
  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      usos.map((u) => (
        <li class="flex items-start gap-4 rounded-2xl border border-borde bg-papel p-6">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-celeste text-azul">
            <Icono nombre={u.icono} class="h-8 w-8" />
          </span>
          <span class="pt-1 text-lg font-bold leading-snug text-texto">{u.texto}</span>
        </li>
      ))
    }
  </ul>
</Seccion>
