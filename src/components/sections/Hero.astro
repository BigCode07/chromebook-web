---
import { Image } from 'astro:assets';
import Seccion from '../ui/Seccion.astro';
import Boton from '../ui/Boton.astro';
import hero from '../../assets/images/hero.jpg';
---

<Seccion id="inicio" labelledby="hero-titulo" reveal={false} class="!pb-16 !pt-[calc(var(--header-h)+2rem)] md:!pt-[calc(var(--header-h)+4rem)]">
  <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
    <div>
      <h1 id="hero-titulo" class="text-[min(2.375rem,11vw)] font-bold sm:text-5xl">
        Una computadora simple y segura para tus viejos.
      </h1>
      <p class="mt-6 max-w-[34rem] text-xl leading-relaxed text-texto-suave">
        Incluye talleres donde otro jubilado les enseña a usarla y a reconocer estafas.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <Boton href="#contacto">Quiero el paquete</Boton>
        <Boton href="#paquete" variante="secundario">Ver qué incluye</Boton>
      </div>
    </div>

    <Image
      src={hero}
      alt="Un hombre mayor usa una laptop en su casa mientras una mujer mayor lo acompaña a su lado."
      widths={[480, 720, 960, 1200]}
      sizes="(min-width: 1024px) 540px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/3] w-full rounded-2xl object-cover"
    />
  </div>
</Seccion>
