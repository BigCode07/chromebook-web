---
import Seccion from '../ui/Seccion.astro';
import Boton from '../ui/Boton.astro';
import Dato from '../ui/Dato.astro';
import { site } from '../../data/site';

const pasos = [
  {
    titulo: 'Comprás el paquete',
    texto: 'Online o en uno de nuestros puntos de atención, en cuotas con tu tarjeta.',
  },
  { titulo: 'Recibe el equipo', dato: site.paquete.entrega },
  {
    titulo: 'Va al taller',
    texto: 'Con un grupo de pares y un embajador que le enseña paso a paso.',
  },
  { titulo: 'Tiene soporte', texto: 'Después de la compra, para cualquier duda.' },
];
---

<Seccion id="como-funciona" fondo="celeste" labelledby="pasos-titulo">
  <h2 id="pasos-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">
    Cuatro pasos, y vos no tenés que ser el soporte técnico
  </h2>
  <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    {
      pasos.map((p, i) => (
        <li class="relative rounded-3xl bg-papel p-7 shadow-[0_8px_24px_-14px_rgba(27,58,92,0.4)]">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-azul font-display text-3xl font-bold text-white">
            {i + 1}
          </span>
          <h3 class="mt-5 text-2xl font-bold">{p.titulo}</h3>
          <p class="mt-3 text-lg text-texto-suave">
            {'texto' in p ? p.texto : <Dato valor={p.dato} />}
          </p>
        </li>
      ))
    }
  </ol>
  <div class="mt-10 flex justify-center">
    <Boton href="#contacto">Quiero el paquete</Boton>
  </div>
</Seccion>
