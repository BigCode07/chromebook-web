---
import Seccion from '../ui/Seccion.astro';
import { site } from '../../data/site';

const pasos = [
  { titulo: 'Comprás el paquete', texto: ['En cuotas, con tu tarjeta.', site.paquete.entrega].join(' ').trim() },
  { titulo: 'Va al taller', texto: 'Un embajador le enseña paso a paso.' },
  { titulo: 'Tiene soporte', texto: site.capacitacion.soporte || 'Para cualquier duda que surja después.' },
];
---

<Seccion id="como-funciona" fondo="papel" labelledby="pasos-titulo">
  <h2 id="pasos-titulo" class="max-w-3xl text-3xl font-bold md:text-[2.5rem]">
    Vos no tenés que ser el soporte técnico
  </h2>
  <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
    {
      pasos.map((p, i) => (
        <li class="border-t-4 border-azul pt-5">
          <h3 class="text-2xl font-bold">
            {i + 1}. {p.titulo}
          </h3>
          <p class="mt-2 text-lg text-texto-suave">{p.texto}</p>
        </li>
      ))
    }
  </ol>
</Seccion>
