---
import Seccion from '../ui/Seccion.astro';

const campo =
  'mt-2 block min-h-[3.75rem] w-full rounded-xl border-2 border-azul/40 bg-white px-4 py-3 text-xl text-texto placeholder:text-texto-suave/70 aria-[invalid=true]:border-terracota';

const opciones = [
  { valor: 'papa', texto: 'Mi papá' },
  { valor: 'mama', texto: 'Mi mamá' },
  { valor: 'ambos', texto: 'Ambos' },
  { valor: 'otro', texto: 'Otro familiar' },
];
---

<Seccion id="contacto" labelledby="contacto-titulo">
  <div class="grid items-start gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div>
      <h2 id="contacto-titulo" class="text-3xl font-bold md:text-[2.75rem]">
        Regalales autonomía. <span class="block">Y tranquilidad para vos.</span>
      </h2>
      <p class="mt-6 text-xl leading-relaxed text-texto-suave">
        Dejanos tus datos y te contamos precio, cuotas y talleres.
      </p>
    </div>

    <div class="rounded-2xl border border-borde bg-papel p-6 text-texto md:p-9">
      <form id="form-contacto" novalidate class="grid gap-6" data-form-contacto>
        <div>
          <label for="f-nombre" class="text-lg font-bold text-azul">Tu nombre</label>
          <input
            id="f-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            aria-describedby="e-nombre"
            class={campo}
          />
          <p id="e-nombre" class="mt-2 hidden text-base font-bold text-terracota" role="alert"></p>
        </div>

        <div>
          <label for="f-tel" class="text-lg font-bold text-azul">Tu teléfono o WhatsApp</label>
          <input
            id="f-tel"
            name="telefono"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            aria-describedby="e-tel"
            class={campo}
          />
          <p id="e-tel" class="mt-2 hidden text-base font-bold text-terracota" role="alert"></p>
        </div>

        <div>
          <label for="f-loc" class="text-lg font-bold text-azul">Localidad</label>
          <input
            id="f-loc"
            name="localidad"
            type="text"
            autocomplete="address-level2"
            required
            aria-describedby="e-loc"
            class={campo}
          />
          <p id="e-loc" class="mt-2 hidden text-base font-bold text-terracota" role="alert"></p>
        </div>

        <fieldset aria-describedby="e-para" class="min-w-0">
          <legend class="text-lg font-bold text-azul">¿Para quién es?</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {
              opciones.map((o) => (
                <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border-2 border-azul/40 bg-white px-4 text-lg font-bold has-[:checked]:border-azul has-[:checked]:bg-celeste">
                  <input type="radio" name="para" value={o.valor} class="h-6 w-6 accent-azul" />
                  {o.texto}
                </label>
              ))
            }
          </div>
          <p id="e-para" class="mt-2 hidden text-base font-bold text-terracota" role="alert"></p>
        </fieldset>

        <button
          type="submit"
          class="inline-flex min-h-14 items-center justify-center rounded-xl bg-terracota px-7 py-3 text-lg font-bold text-white transition-colors hover:bg-terracota-oscuro"
        >
          Quiero que me contacten
        </button>
      </form>

      <div data-exito hidden role="status" tabindex="-1" class="py-6 text-center">
        <p class="text-3xl font-bold text-azul">¡Gracias, <span data-exito-nombre></span>!</p>
        <p class="mt-4 text-xl text-texto-suave">
          Este formulario todavía está en prueba: tus datos no se enviaron.
        </p>
      </div>
    </div>
  </div>
</Seccion>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form-contacto]');
  const exito = document.querySelector<HTMLElement>('[data-exito]');

  function error(id: string, campo: HTMLElement | null, mensaje: string) {
    const p = document.getElementById(id);
    if (!p) return;
    if (mensaje) {
      p.textContent = mensaje;
      p.classList.remove('hidden');
      campo?.setAttribute('aria-invalid', 'true');
    } else {
      p.textContent = '';
      p.classList.add('hidden');
      campo?.removeAttribute('aria-invalid');
    }
  }

  function validar(f: HTMLFormElement) {
    const nombre = f.querySelector<HTMLInputElement>('#f-nombre')!;
    const tel = f.querySelector<HTMLInputElement>('#f-tel')!;
    const loc = f.querySelector<HTMLInputElement>('#f-loc')!;
    const para = f.querySelector<HTMLInputElement>('input[name="para"]:checked');
    const primerRadio = f.querySelector<HTMLInputElement>('input[name="para"]')!;

    const digitos = tel.value.replace(/[\s\-()+]/g, '');
    const errores: { campo: HTMLElement; id: string; msg: string }[] = [];

    if (nombre.value.trim().length < 2)
      errores.push({ campo: nombre, id: 'e-nombre', msg: 'Escribí tu nombre (al menos 2 letras).' });
    if (!/^\d{8,15}$/.test(digitos))
      errores.push({
        campo: tel,
        id: 'e-tel',
        msg: 'Escribí un teléfono con entre 8 y 15 números. Por ejemplo: 3764 123456.',
      });
    if (loc.value.trim().length < 2)
      errores.push({ campo: loc, id: 'e-loc', msg: 'Escribí tu localidad.' });
    if (!para) errores.push({ campo: primerRadio, id: 'e-para', msg: 'Elegí para quién es el paquete.' });

    // Limpia errores de los campos que están bien
    [
      ['e-nombre', nombre],
      ['e-tel', tel],
      ['e-loc', loc],
      ['e-para', primerRadio],
    ].forEach(([id, el]) => {
      if (!errores.some((e) => e.id === id)) error(id as string, el as HTMLElement, '');
    });
    errores.forEach((e) => error(e.id, e.campo === primerRadio ? null : e.campo, e.msg));

    return { errores, nombre: nombre.value.trim() };
  }

  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const { errores, nombre } = validar(form);
    if (errores.length > 0) {
      errores[0].campo.focus();
      return;
    }
    // Maqueta: no se envía nada a ningún servidor.
    const spanNombre = exito?.querySelector('[data-exito-nombre]');
    if (spanNombre) spanNombre.textContent = nombre;
    form.hidden = true;
    if (exito) {
      exito.hidden = false;
      exito.focus();
    }
  });
</script>
