---
import { Image } from 'astro:assets';
import Seccion from '../ui/Seccion.astro';
import { site } from '../../data/site';
---

<Seccion id="aliados" fondo="papel" labelledby="aliados-titulo">
  <h2 id="aliados-titulo" class="text-3xl font-bold md:text-[2.5rem]">Nos acompañan</h2>
  <ul class="mt-8 flex flex-wrap items-center gap-10">
    {
      site.aliados.map((a) => (
        <li>
          <Image src={a.logo} alt={a.nombre} class="max-h-16 w-auto object-contain" />
        </li>
      ))
    }
  </ul>
</Seccion>
