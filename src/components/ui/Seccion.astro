---
interface Props {
  id?: string;
  fondo?: 'niebla' | 'papel' | 'azul';
  class?: string;
  labelledby?: string;
  /** Aparición suave al hacer scroll. Desactivar en lo que se ve al cargar. */
  reveal?: boolean;
}
const { id, fondo = 'niebla', class: clase = '', labelledby, reveal = true } = Astro.props;

const fondos = {
  niebla: 'bg-niebla',
  papel: 'bg-papel',
  azul: 'sobre-azul bg-azul text-celeste',
};
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={[reveal && 'reveal', fondos[fondo], 'py-14 md:py-20', clase]}
>
  <div class="mx-auto w-full max-w-[var(--container)] px-5 md:px-8">
    <slot />
  </div>
</section>
