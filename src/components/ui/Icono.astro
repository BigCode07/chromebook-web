---
export type NombreIcono = 'whatsapp' | 'menu' | 'compu' | 'escudo' | 'chat' | 'persona';

interface Props {
  nombre: NombreIcono;
  class?: string;
}
const { nombre, class: clase = 'h-7 w-7' } = Astro.props;

const trazos: Record<NombreIcono, string> = {
  whatsapp: 'M4 20l1.2-4A8 8 0 1112 20a8 8 0 01-3.8-1L4 20zM9 9c0 3 3 6 6 6l1.2-1.4-2-1-.9.7c-.8-.3-1.9-1.4-2.2-2.2l.7-.9-1-2L9 9z',
  menu: 'M4 7h16M4 12h16M4 17h16',
  compu: 'M5 6a1.5 1.5 0 011.5-1.5h11A1.5 1.5 0 0119 6v9H5V6zM2.5 18h19l-1 1.5h-17l-1-1.5z',
  escudo: 'M12 3l7.5 3v5.5c0 4.6-3.1 8.2-7.5 9.5-4.4-1.3-7.5-4.9-7.5-9.5V6L12 3zM8.8 12l2.4 2.4 4.2-4.6',
  chat: 'M4 5h16v11H9l-5 4V5z',
  persona: 'M12 11a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0',
};
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={trazos[nombre]}></path>
</svg>
