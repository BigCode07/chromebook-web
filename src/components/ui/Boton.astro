---
interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'claro';
  class?: string;
  externo?: boolean;
}
const { href, variante = 'primario', class: clase = '', externo = false } = Astro.props;

const base =
  'inline-flex min-h-14 items-center justify-center gap-2 rounded-xl px-7 py-3 text-center text-[1.0625rem] font-bold no-underline transition active:scale-[0.98]';
const variantes = {
  primario: 'bg-accion text-azul-oscuro hover:bg-accion-oscuro hover:text-azul-oscuro',
  secundario:
    'border-2 border-azul bg-transparent text-azul hover:bg-azul hover:text-white',
  claro: 'border-2 border-white bg-transparent text-white hover:bg-white hover:text-azul',
};
---

<a
  href={href}
  class:list={[base, variantes[variante], clase]}
  {...externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</a>
