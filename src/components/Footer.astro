---
import Dato from './ui/Dato.astro';
import { site } from '../data/site';

const secciones = [
  { href: '#paquete', texto: 'El paquete' },
  { href: '#capacitacion', texto: 'Capacitación' },
  { href: '#donde', texto: 'Dónde encontrarnos' },
  { href: '#proyecto', texto: 'El proyecto' },
  { href: '#embajadores', texto: 'Sumate como embajador' },
  { href: '#aliados', texto: 'Aliados' },
  { href: '#preguntas', texto: 'Preguntas frecuentes' },
];
const fuentes = [
  'Relevamiento sobre exposición a estafas en personas mayores, citado por Canal 12 Misiones.',
  'INDEC, Acceso y uso de TIC, hogares urbanos, cuarto trimestre de 2021.',
  'Padrón proyectado ANSES 2026 y Presupuesto 2027 (proyección de jubilados).',
  'Precio de referencia del equipo: Frávega, Chromebook modelo 2021, compra internacional.',
  'Relevamiento de precios de notebooks de entrada, 2026.',
];
const enlaceFooter =
  'inline-flex min-h-12 items-center text-lg text-white underline underline-offset-4 hover:text-[#f3c969]';
---

<footer class="bg-azul-oscuro text-[#d3deea]">
  <div class="mx-auto w-full max-w-[var(--container)] px-5 py-14 md:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-3xl font-bold text-white"><Dato valor={site.marca} /></p>
        <p class="mt-3 text-lg">{site.lema}</p>
        <ul class="mt-5 grid gap-1 text-lg">
          <li><Dato valor={site.contacto.telefono} /></li>
          <li><Dato valor={site.contacto.email} /></li>
          {
            site.contacto.redes.length === 0 ? (
              <li>
                <Dato valor={{ pendiente: true, etiqueta: 'redes sociales' }} />
              </li>
            ) : (
              site.contacto.redes.map((r) => (
                <li>
                  <a href={r.url} class={enlaceFooter} target="_blank" rel="noopener noreferrer">
                    {r.nombre}
                  </a>
                </li>
              ))
            )
          }
        </ul>
      </div>

      <nav aria-label="Secciones del sitio">
        <h2 class="text-xl font-bold text-white">Secciones</h2>
        <ul class="mt-3 grid">
          {
            secciones.map((s) => (
              <li>
                <a href={s.href} class={enlaceFooter}>
                  {s.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-xl font-bold text-white">Fuentes de los datos citados</h2>
        <ul class="mt-3 grid list-disc gap-2 pl-5 text-base">
          {fuentes.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-2 border-t border-white/20 pt-6 text-base">
      <li><Dato valor={site.legales.terminos} /></li>
      <li><Dato valor={site.legales.privacidad} /></li>
      <li>
        <a href={site.legales.defensaConsumidor} class={enlaceFooter} target="_blank" rel="noopener noreferrer">
          Defensa del consumidor
        </a>
      </li>
    </ul>
  </div>
</footer>
