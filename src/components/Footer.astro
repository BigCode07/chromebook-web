---
import { site } from '../data/site';

const { telefono, email, redes } = site.contacto;
const legales = [
  { texto: 'Términos y condiciones', url: site.legales.terminos },
  { texto: 'Política de privacidad', url: site.legales.privacidad },
  { texto: 'Defensa del consumidor', url: site.legales.defensaConsumidor },
].filter((l) => l.url);
const enlaceFooter =
  'inline-flex min-h-12 items-center text-lg text-white underline underline-offset-4 hover:text-accion';
---

<footer class="sobre-azul bg-azul-oscuro text-celeste">
  <div class="mx-auto flex w-full max-w-[var(--container)] flex-col gap-8 px-5 py-12 md:flex-row md:items-end md:justify-between md:px-8">
    <div>
      <p class="text-3xl font-bold text-white">{site.marca}</p>
      <p class="mt-2 text-lg">{site.lema}</p>
    </div>
    <ul class="flex flex-wrap gap-x-8">
      {telefono && <li><a href={`tel:${telefono.replace(/[^\d+]/g, '')}`} class={enlaceFooter}>{telefono}</a></li>}
      {email && <li><a href={`mailto:${email}`} class={enlaceFooter}>{email}</a></li>}
      {
        redes.map((r) => (
          <li><a href={r.url} class={enlaceFooter} target="_blank" rel="noopener noreferrer">{r.nombre}</a></li>
        ))
      }
      {
        legales.map((l) => (
          <li><a href={l.url} class={enlaceFooter} target="_blank" rel="noopener noreferrer">{l.texto}</a></li>
        ))
      }
    </ul>
  </div>
</footer>
