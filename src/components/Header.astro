---
import Boton from './ui/Boton.astro';
import Icono from './ui/Icono.astro';
import ControlLetra from './ControlLetra.astro';
import { site } from '../data/site';
import { enlaceWhatsapp, hayWhatsapp } from '../lib/utils';

const nav = [
  { href: '#paquete', texto: 'El paquete' },
  { href: '#como-funciona', texto: 'Cómo funciona' },
  { href: '#capacitacion', texto: 'Capacitación' },
  { href: '#preguntas', texto: 'Preguntas' },
];
const wa = enlaceWhatsapp('Hola, quiero consultar por el paquete Chromebook + capacitación.');
const waExterno = wa.startsWith('http');
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-borde bg-papel/95 backdrop-blur" data-header>
  <div class="mx-auto flex min-h-[4.5rem] w-full max-w-[var(--container)] items-center justify-between gap-3 px-5 md:px-8">
    <a href="#inicio" class="inline-flex min-h-12 items-center whitespace-nowrap text-xl sm:text-2xl font-bold text-azul no-underline hover:text-azul" aria-label="Ir al inicio">
      {site.marca}
    </a>
    <nav aria-label="Secciones principales" class="hidden xl:block">
      <ul class="flex items-center">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                class="inline-flex min-h-12 items-center whitespace-nowrap rounded-xl px-1.5 text-[1.0625rem] font-bold text-azul no-underline hover:bg-celeste hover:text-azul"
              >
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden lg:block"><ControlLetra /></div>
      <div class="hidden lg:block"><Boton href="#contacto" class="whitespace-nowrap !min-h-12 !px-4">Quiero el paquete</Boton></div>
      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="menu-movil"
        class="inline-flex h-12 items-center gap-2 rounded-xl border-2 border-azul px-2 font-bold sm:px-4 text-azul hover:bg-celeste xl:hidden"
      >
        <Icono nombre="menu" class="h-6 w-6" />
        <span data-menu-texto>Menú</span>
      </button>
    </div>
  </div>

  <div id="menu-movil" hidden class="max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-borde bg-papel xl:hidden">
    <div class="mx-auto w-full max-w-[var(--container)] px-5 pb-6 pt-4 md:px-8">
      <ul class="grid gap-1 md:grid-cols-2">
        {
          nav.map((n) => (
            <li>
              <a
                href={n.href}
                class="flex min-h-14 items-center rounded-xl px-3 text-lg font-bold text-azul no-underline hover:bg-celeste hover:text-azul"
              >
                {n.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 flex flex-col gap-3 lg:hidden">
        <ControlLetra class="justify-start" />
        <Boton href="#contacto" class="w-full">Quiero el paquete</Boton>
        {hayWhatsapp() && <Boton href={wa} variante="secundario" class="w-full" externo={waExterno}>Escribinos por WhatsApp</Boton>}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.getElementById('menu-movil');
  const texto = btn?.querySelector<HTMLElement>('[data-menu-texto]');

  function abrir(abierto: boolean) {
    if (!btn || !panel) return;
    panel.hidden = !abierto;
    btn.setAttribute('aria-expanded', String(abierto));
    if (texto) texto.textContent = abierto ? 'Cerrar' : 'Menú';
  }

  btn?.addEventListener('click', () => abrir(btn.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      abrir(false);
      btn.focus();
    }
  });

  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));

  // Al ensanchar la ventana, el menú móvil se cierra solo
  window.matchMedia('(min-width: 1280px)').addEventListener('change', (m) => {
    if (m.matches) abrir(false);
  });
</script>
